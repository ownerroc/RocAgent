{
  "name": "rocsystem",
  "version": "2.0.0",
  "description": "RocSystem - Primary AI Agent Infrastructure for RocAI.",
  "author": "Ivan Ssl # Owner-RocAgent (ownerroc)",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ownerroc/RocAgent.git"
  },
  "type": "module",
  "scripts": {
    "predev": "pgrep -f sshd >/dev/null || (/data/data/com.termux/files/usr/bin/sshd && echo '[SSH] Daemon started on port 8022'); echo 'Starting RocSystem v2.0.0'",
    "dev": "NODE_OPTIONS='--expose-gc --max-old-space-size=512 --dns-result-order=ipv4first' tsx server.ts",
    "prewebui": "pgrep -f sshd >/dev/null || (/data/data/com.termux/files/usr/bin/sshd && echo '[SSH] Daemon started on port 8022'); echo 'Starting RocSystem v2.0.0'",
    "webui": "NODE_OPTIONS='--expose-gc --max-old-space-size=512 --dns-result-order=ipv4first' tsx server.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=512' vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "prestart": "pgrep -f sshd >/dev/null || (/data/data/com.termux/files/usr/bin/sshd && echo '[SSH] Daemon started on port 8022')",
    "start": "NODE_OPTIONS='--expose-gc --max-old-space-size=512 --dns-result-order=ipv4first' node dist/server.cjs",
    "start:dev": "NODE_OPTIONS='--expose-gc --max-old-space-size=512 --dns-result-order=ipv4first' tsx server.ts",
    "clean": "rm -rf dist server.js",
    "postinstall": "node scripts/postinstall.js",
    "lint": "tsc --noEmit",
    "test": "SHELL_GUARD=warn npx tsx server/__tests__/commandGuard.test.ts && npx tsx server/__tests__/shellGuard.integration.test.ts && npx tsx server/__tests__/auth.test.ts && npx tsx server/__tests__/neonDb.test.ts && npx tsx server/__tests__/decryptFile.test.ts && npx tsx server/__tests__/missingBinaryAndCatalog.test.ts && bash tools/__tests__/rocvault.test.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@scaleway/sdk": "^4.0.8",
    "@scaleway/sdk-client": "^2.7.0",
    "@scaleway/sdk-container": "^2.13.1",
    "@scaleway/sdk-function": "^2.12.1",
    "@scaleway/sdk-k8s": "^2.22.1",
    "@scaleway/sdk-rdb": "^2.13.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "scaleway": "^0.8.0",
    "ssh2": "^1.17.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "jimp": "^1.6.1",
    "rollup": "^4.63.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.125.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.63.0",
    "rollup": "^4.63.0"
  }
}
